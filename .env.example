## Supabase
VITE_SUPABASE_URL="https://<your-project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<your-publishable-key>"
DATABASE_URL="postgresql://postgres.<your-project-id>:<your-project-password>@<your-project-location>.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_SECRET_KEY=sb_secret_<your-secret-key>

## App URLs and OAuth
VITE_SITE_BASE_URL="https://pairresearch.io"
VITE_GOOGLE_CLIENT_ID="<your-google-oauth-client-id>.apps.googleusercontent.com"
R2_PUBLIC_DOMAIN="https://r2.pairresearch.io"

## Cloudflare Turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="<your-turnstile-site-key>"
CLOUDFLARE_TURNSTILE_SECRET_KEY=<your-turnstile-secret-key>

## Contact email
RESEND_API_KEY="<your-resend-api-key>"
CONTACT_FROM_EMAIL="Pair Research <support@notify.pairresearch.io>"
CONTACT_ADMIN_EMAIL="<admin@example.com>"
